---

<div class='crosshair-widget'>
	<div class='stage' id='stage'>
		<svg viewBox='0 0 360 300' xmlns='http://www.w3.org/2000/svg'>
			<line class='diag' id='d1' x1='-12' y1='150' x2='372' y2='150' data-angle='38.66'></line>
			<line class='diag' id='d2' x1='-12' y1='150' x2='372' y2='150' data-angle='-38.66'></line>
			<line class='axis' id='axis' x1='30' y1='150' x2='330' y2='150'></line>

			<line class='diag-highlight' id='hAbout' x1='180' y1='150' x2='30' y2='30'></line>
			<line class='diag-highlight' id='hBlog' x1='180' y1='150' x2='330' y2='30'></line>
			<line class='diag-highlight' id='hContact' x1='180' y1='150' x2='330' y2='270'></line>
			<line class='diag-highlight' id='hLab' x1='180' y1='150' x2='30' y2='270'></line>

			<circle cx='180' cy='150' r='4' class='glow'></circle>
			<circle cx='180' cy='150' r='2.5' class='dot-core'></circle>

			<a href='/about'>
				<text class='label' id='lAbout' x='30' y='22' text-anchor='start'>ABOUT</text>
				<rect class='hit' x='20' y='10' width='80' height='24'></rect>
			</a>
			<a href='/blog'>
				<text class='label' id='lBlog' x='330' y='22' text-anchor='end'>BLOGS</text>
				<rect class='hit' x='270' y='10' width='70' height='24'></rect>
			</a>
			<a href='/lab'>
				<text class='label' id='lContact' x='330' y='285' text-anchor='end'>LAB</text>
				<rect class='hit' x='270' y='264' width='70' height='24'></rect>
			</a>
			<a href='/projects'>
				<text class='label' id='lLab' x='30' y='285' text-anchor='start'>PROJECTS</text>
				<rect class='hit' x='20' y='264' width='80' height='24'></rect>
			</a>
		</svg>
		<p class="hint">New here? Start with About. Otherwise, pick any vertex.</p>
	</div>
	<script>
		import '../scripts/crosshair_widget.ts';
	</script>
</div>

<style>
	* {
		user-select: none;
	}

	svg {
		background-color: var(--color-background-shadow);
		border: 1px solid var(--color-shadow);
		border-radius: 10px;
		width: 100%;
		height: 100%;
		transition: transform 0.15s ease-out;
		pointer-events: none;
	}

	svg.loaded {
		pointer-events: all;
	}

	.hint	{
		color: var(--color-muted);
	}

	.stage {
		width: 480px;
		aspect-ratio: 480 / 400;
		height: auto;
		perspective: 900px;
	}

	.diag {
		stroke: var(--color-shadow);
		stroke-width: 1;
		transform-origin: 180px 150px;
		transform: rotate(0deg);
		transition:
			stroke 0.3s ease,
			stroke-width 0.3s ease,
			transform 1s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.axis {
		stroke: var(--color-link);
		stroke-width: 1;
		transition: stroke-dashoffset 0.8s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.glow {
		animation: pulse 2.5s ease-out infinite;
		animation-play-state: paused;
		opacity: 0;
		transition: opacity 0.4s ease;
		transform-origin: 180px 150px;
		fill: var(--color-link);
		fill-opacity: 0.5;
		transition:
			cx 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			cy 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.4s ease;
	}

	.dot-core {
		opacity: 0;
		transform: scale(0);
		transform-origin: 180px 150px;
		transition:
			cx 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			cy 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.4s ease,
			transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
		fill: var(--color-link);
	}

	.loaded .glow {
		opacity: 1;
		animation-play-state: running;
	}

	.loaded .dot-core {
		opacity: 1;
		transform: scale(1);
	}

	@keyframes pulse {
		0% {
			r: 4;
			opacity: 1;
		}

		100% {
			r: 20;
			opacity: 0;
		}
	}

	.label {
		fill: var(--color-muted);
		font-size: 11px;
		letter-spacing: 2px;
		cursor: pointer;
		opacity: 0;
		transition:
			fill 0.3s ease,
			opacity 0.6s ease;
	}

	.loaded .label {
		opacity: 1;
		display: block;
	}

	.hit {
		fill: transparent;
		cursor: pointer;
	}

	.loaded .coord {
		opacity: 1;
	}

	.label.active {
		stroke: var(--color-link);
	}
	
	.diag-highlight {
		opacity: 0;
		stroke: var(--color-link);
		stroke-width: 1.5;
		pointer-events: none;
		transition: stroke-dashoffset 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.diag-highlight.active {
		opacity: 1;
	}

	@media screen and (max-width: 768px) {
		.stage {
			width: min(480px, 100%)
		}

		.crosshair-widget {
			margin-inline: auto;
		}
	}
</style>
