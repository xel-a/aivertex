---
import { type NodeId } from '../config/navigation';
import { site } from '../config/site';
import MobileMenu from './MobileMenu.astro';
import NavLine from './NavLine.astro';

interface Props {
	pageId?: NodeId;
}

const { pageId } = Astro.props;
---

<header>
	<a href='/' class='aivertex-logo'>
		<svg class='icon' viewBox='0 0 260 260' xmlns='http://www.w3.org/2000/svg'>
			<rect width='260' height='260' fill='transparent'></rect>
			<g class='needle'>
				<polygon points='130,72 112,130 148,130' fill='#FFFFFF'></polygon>
				<polygon points='130,188 112,130 148,130' fill='none' stroke='#FFFFFF' stroke-width='3' stroke-linejoin='round'></polygon>
			</g>
			<circle cx='130' cy='130' r='9' fill='#1D6BFF'></circle>
		</svg>
		<h1 class='logo-title'>{site.domain}</h1>
	</a>
	{
		pageId ? (
			<div class='navigation-menu'>
				<div class='desktop-nav'>
					<NavLine current={pageId} />
				</div>
				<div class='mobile-nav'>
					<MobileMenu current={pageId} />
				</div>
			</div>
		) : null
	}
</header>

<style>
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.aivertex-logo {
		display: flex;
		align-items: center;
		cursor: pointer;
		width: fit-content;
		user-select: none;
		text-decoration: none;
	}

	.logo-title {
		margin-left: -15px;
		color: var(--color-text);
		font-size: var(--text-lead);
		transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.icon {
		width: 80px;
		height: 80px;
		margin-left: -30px;
	}
	.needle {
		transform-origin: 130px 130px;
		transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.aivertex-logo:hover .logo-title {
		transform: translateY(-2px);
	}

	.aivertex-logo:hover .needle {
		transform: rotate(18deg);
	}

	.desktop-nav {
	}

	.mobile-nav {
		display: none;
	}

	@media screen and (max-width: 640px) {
		.desktop-nav {
			display: none;
		}

		.mobile-nav {
			display: block;
		}
	}
</style>
