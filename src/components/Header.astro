---

---

<header>
	<div class='aivertex-logo'>
		<svg class='icon' viewBox='0 0 260 260' xmlns='http://www.w3.org/2000/svg'>
			<rect width='260' height='260' fill='transparent'></rect>
			<g class='needle'>
				<polygon points='130,72 112,130 148,130' fill='#FFFFFF'></polygon>
				<polygon points='130,188 112,130 148,130' fill='none' stroke='#FFFFFF' stroke-width='3' stroke-linejoin='round'></polygon>
			</g>
			<circle class='pivot' cx='130' cy='130' r='9' fill='#2F6BFF'></circle>
		</svg>
		<h1 class='logo-title'>aivertex</h1>
	</div>
</header>

<style>
	.aivertex-logo {
		display: flex;
		align-items: center;
		cursor: pointer;
		width: fit-content;
	}

	.aivertex-logo:hover .logo-title {
		transform: translateY(-2px);
	}

	.logo-title {
		margin-left: -15px;
		color: var(--color-text);
		font-size: 1.2rem;
		transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.icon {
		width: 80px;
		height: 80px;
		cursor: pointer;
		margin-left: -30px;
	}
	.needle {
		transform-origin: 130px 130px;
		transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.icon:hover .needle {
		transform: rotate(18deg);
	}
	.pivot {
		transition:
			r 0.4s ease,
			opacity 0.4s ease;
	}
</style>
