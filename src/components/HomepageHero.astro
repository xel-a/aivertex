---
import GraphView from "./GraphView.astro";
import HomepageHeroText from "./HomepageHeroText.astro";


---

<div class="homepage-hero">
  <HomepageHeroText />
  <GraphView />
</div>

<style>
  .homepage-hero {
    display: flex;
		justify-content: space-between;
    gap: 20px;
    padding-bottom: 40px;
  }

  @media screen and (max-width: 768px) {
    .homepage-hero {
      flex-direction: column;
      text-align: left;
      gap: 40px;
    }
  }
</style>