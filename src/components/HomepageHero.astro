---
import CrosshairWidget from "./CrosshairWidget.astro";
import HomepageHeroText from "./HomepageHeroText.astro";


---

<div class="homepage-hero">
  <HomepageHeroText />
  <CrosshairWidget />
</div>

<style>
  .homepage-hero {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
  }

  @media screen and (min-width: 636px) {
    .homepage-hero {
      flex-direction: row;
    }
  }
</style>