---
import CurrentTraversal from './CurrentTraversal.astro';
---

<div class="hero-container">
  <p class="hero-eyebrow">Axel Ignacio — Following curiosity wherever it leads</p>
  <h1 class="hero-heading">A place where every line of work converges</h1>
  <CurrentTraversal variant="compact" />
</div>

<style>
  .hero-eyebrow {
    color: var(--color-link);
    letter-spacing: 4px;
    font-size: var(--text-lead);
  }

  .hero-heading {
    font-size: var(--text-display);
    animation: slide-up 0.5s ease-out;
  }

  .hero-subheading {
    color: var(--color-muted);
    font-size: var(--text-body);
  }

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
</style>
