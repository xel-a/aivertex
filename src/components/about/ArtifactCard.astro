---
import { type Project } from '../../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const tagsLength = project.tags.length;
const tagLimit = 4;
---

<div class="artifact-card">
  <h3 class="title">{project.title}</h3>
  <p class="description">{project.description}</p>
  <div class="tags">
    {project.tags.map((tag) => <p class="tag">{tag}</p>)}
    {
      tagsLength - tagLimit > 0 ? (
        <span class="tag-excess">+ {tagsLength - tagLimit} more</span>
      ) : null
    }
  </div>
  <div class="project-links">
    {
      project.links.repository ? (
        <a href={project.links.repository.url} class="project-link">
          {project.links.repository.name} &nearr;
        </a>
      ) : null
    }

    {
      project.links.url ? (
        <a href={project.links.url} class="project-link">
          Site &nearr;
        </a>
      ) : null
    }

    <a href={`projects/${project.slug}`} class="project-link">Overview &nearr;</a>
  </div>
</div>

<style>
  .artifact-card {
    background-color: var(--color-background-shadow);
    border: 1px solid var(--color-shadow);
    border-radius: 10px;
    padding: 20px;
  }

  .title {
    margin-block: 0;
  }

  .description {
    font-size: var(--text-body-small);
    color: var(--color-muted);
    margin-block: 10px;
  }

  .tags {
    align-items: center;
    margin-block: 20px;
  }

  .tag {
    line-height: 1.25;
  }

  .tag-excess {
    font-size: var(--text-meta);
    color: var(--color-shadow);
  }

  .project-links {
    display: flex;
    gap: 10px;
  }

  .project-link {
    text-decoration: none;
    color: var(--color-link);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
    font-size: var(--text-meta);
    font-weight: bold;
  }

  .project-link:hover {
    border-color: var(--color-link);
  }
</style>
