---
import MilestoneItem from './MilestoneItem.astro';
import { milestones } from '../../data/milestones';

const milestoneYears = [...new Set(milestones.map((milestone) => milestone.date.slice(0, 4)))];
---

{
  milestoneYears.map((year) => (
    <fieldset class="milestone-group">
      <legend class="milestone-year">{year}</legend>
      <MilestoneItem year={year} />
    </fieldset>
  ))
}

<style>
  .milestone-group {
    border: 1px solid var(--color-shadow);
    padding: 10px 20px 30px;
    margin: 0;
    background-color: var(--color-background-shadow);
    border-radius: 10px;
  }

  .milestone-year {
    font-size: var(--text-meta);
    font-weight: bold;
    padding: 0 10px;
  }

  .milestone-group:not(:last-of-type) {
    margin-bottom: 30px;
  }
</style>
