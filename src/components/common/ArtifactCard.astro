---
import type { CollectionEntry } from 'astro:content';
import { slugify } from '../../utils/strings';

interface Props {
  project: CollectionEntry<'project'>;
}

const { project } = Astro.props;
const tagsLength = project.data.tags.length;
const tagLimit = 4;
---

<div class="artifact-card">
  <h3 class="title">{project.data.title}</h3>
  <p class="description">{project.data.description}</p>
  <div class="tags">
    {
      project.data.tags.map((tag) => (
        <a href={`/tags/${slugify(tag)}`} class="tag">
          {tag}
        </a>
      ))
    }
    {
      tagsLength - tagLimit > 0 ? (
        <span class="tag-excess">+ {tagsLength - tagLimit} more</span>
      ) : null
    }
  </div>
  <div class="project-links">
    {
      project.data.links?.site ? (
        <a href={project.data.links.site} class="project-link">
          Site &nearr;
        </a>
      ) : null
    }

    {
      project.data.links?.repository ? (
        <a href={project.data.links.repository} class="project-link">
          Source &nearr;
        </a>
      ) : null
    }

    <a href={`projects/${project.id}`} class="project-link">Overview &nearr;</a>
  </div>
</div>

<style>
  .artifact-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 20px;
  }

  .title {
    margin-block: 0;
  }

  .description {
    font-size: var(--text-body-small);
    color: var(--color-muted);
    margin-block: 10px;
  }

  .tags {
    align-items: center;
    margin-block: 20px;
  }

  .tag-excess {
    font-size: var(--text-meta);
    color: var(--color-border);
  }

  .project-links {
    display: flex;
    gap: 10px;
  }

  .project-link {
    text-decoration: none;
    color: var(--color-link);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
    font-size: var(--text-meta);
    font-weight: bold;
  }

  .project-link:hover {
    border-color: var(--color-link);
  }
</style>
