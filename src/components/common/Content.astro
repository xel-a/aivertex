---
import { formatDate } from '../../utils/date';
import { padContentLength } from '../../utils/strings';

interface Props {
  type: string;
  posts: any;
  isLabContent?: boolean;
}

const { type, posts, isLabContent } = Astro.props;
const filteredPosts = posts.filter((post: any) =>
  isLabContent ? post.data.type === type : post.type === type
);
const postsByYear = Object.entries(
  Object.groupBy(filteredPosts, (post: any) =>
    formatDate({ date: post.data.pubDate, isYear: true })
  )
).sort(([yearA], [yearB]) => yearB.localeCompare(yearA));
---

{
  postsByYear.length > 0 ? (
    <fieldset class="content-group-type">
      <legend class="content-group-type-title">
        <h2>{type.toUpperCase()}</h2>
      </legend>
      {postsByYear.map(([year, posts]: [string, any]) => (
        <div class="content-group-year">
          <h3 class="content-group-year-title">
            {year} &nbsp; &middot; &nbsp {padContentLength(posts.length)}
          </h3>
          {posts.map((post: any) => (
            <a href={post.path} class="content">
              <div class="content-info">
                <p class="content-date">
                  {formatDate({ date: post.data.pubDate, isMonthDay: true })}
                </p>
                <p class="content-title">{post.data.title}</p>
              </div>
            </a>
          ))}
        </div>
      ))}
    </fieldset>
  ) : null
}

<style>
  .content-group-type {
    border: 1px solid var(--color-shadow);
    border-inline: none;
    margin-top: 40px;
  }

  .content-group-type:not(:first-of-type) {
    margin-top: 60px;
  }

  .content-group-type:last-of-type {
    margin-bottom: 60px;
  }

  .content-group-type-title h2 {
    font-size: var(--text-title);
    margin: 0;
  }

  .content-group-year:not(:last-of-type) {
    margin-bottom: 30px;
  }

  .content-group-year-title {
    margin: 0 0 10px;
  }

  .content {
    padding-inline: 10px;
  }

  .content-info {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .content {
    text-decoration: none;
    display: block;
    font-size: var(--text-body-small);
    border-radius: 5px;
    transition: background-color 250ms ease;
  }

  .content p {
    margin-block: 5px;
    cursor: pointer;
  }

  .content-date {
    color: var(--color-muted);
    transition: color 250ms ease;
  }

  .content-title {
    flex: 1;
    width: fit-content;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition:
      color 250ms ease,
      text-decoration-color 250ms ease;
  }

  .content:hover {
    background-color: var(--color-background-shadow);
  }

  .content:hover .content-date {
    color: var(--color-text);
  }

  .content:hover .content-title {
    color: var(--color-link);
    text-decoration-color: var(--color-link);
  }

  @media screen and (max-width: 768px) {
    .content-info {
      flex-direction: column;
      gap: 0;
      align-items: unset;
    }
  }
</style>
