---
import { formatDate } from '../../utils/date';
import { padContentLength } from '../../utils/strings';
import ContentItem from './ContentItem.astro';

interface Props {
  posts: any;
  showContentType: boolean;
}

const { posts, showContentType } = Astro.props;
const postsByYear = Object.entries(
  Object.groupBy(posts, (post: any) => formatDate({ date: post.data.pubDate, isYear: true }))
).sort(([yearA], [yearB]) => yearB.localeCompare(yearA));
---

{
  postsByYear.length > 0
    ? postsByYear.map(([year, groupedPosts]) => (
        <fieldset class="content-group">
          <legend>
            <h2 class="content-group-title">
              <span>{year}</span> &nbsp; &middot; &nbsp; {padContentLength(groupedPosts!.length)}
            </h2>
          </legend>
          {groupedPosts!.map((post: any) => (
            <ContentItem post={post} showContentType={showContentType} />
          ))}
        </fieldset>
      ))
    : null
}

<style>
  .content-group {
    border: 1px solid var(--color-border);
    border-inline: none;
    margin-top: 40px;
  }

  .content-group:not(:first-of-type) {
    margin-top: 60px;
  }

  .content-group:last-of-type {
    margin-bottom: 60px;
  }

  .content-group-title {
    font-size: var(--text-title);
    margin: 0;
  }
</style>
