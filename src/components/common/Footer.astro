---
import { site } from '../../config/site';
---

<footer class="footer-content">
  <p class="site">{site.author.name} | {site.name}</p>
  <p class="footer-text">Where ideas converge.</p>
</footer>

<style>
  .footer-content {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    font-size: var(--text-meta);
    border-top: 1px solid var(--color-border);
    padding-block: 10px;
  }

  .site {
    color: var(--color-muted);
    font-weight: bold;
  }

  .footer-text {
    color: var(--color-muted);
  }
</style>
