---
import { social } from '../../config/social';
---

<a
  class="linkedin-icon"
  href={social.find((entry) => entry.id === 'linkedin')?.url}
  target="_blank"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="0.88em" height="1em" viewBox="0 0 448 512">
    <path d="M0 0h448v512H0z" fill="none"></path>
    <path
      class="icon-path"
      d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3M135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5c0 21.3-17.2 38.5-38.5 38.5m282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7c-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5c67.2 0 79.7 44.3 79.7 101.9z"
    ></path>
  </svg>
  <div class="tooltip">
    <p>LinkedIn</p>
  </div>
</a>

<style>
  .linkedin-icon {
    position: relative;
    border: unset;
    width: 24px;
    height: auto;
    cursor: pointer;
  }

  svg {
    width: 100%;
    height: 100%;
  }

  .icon-path {
    fill: var(--color-muted);
    transition: fill 250ms ease-in-out;
  }

  svg:hover .icon-path {
    fill: var(--color-text);
  }

  svg:hover + .tooltip {
    opacity: 1;
  }

  .tooltip {
    position: absolute;
    top: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 5px;
    box-shadow: var(--color-surface);
    color: var(--color-text);
    display: block;
    padding: 5px 10px;
    pointer-events: none;
    transition: opacity var(--transition);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-120%);
    transition: opacity 250ms ease-in-out;
  }

  .tooltip > p {
    margin: 0;
    font-size: var(--text-meta);
    font-weight: bold;
  }

  .tooltip > ::after {
    position: absolute;
    background-color: var(--color-surface);
    height: 5px;
    width: 5px;
    content: '';
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    bottom: -3px;
    left: 5px;
    transform: rotate(45deg);
  }
</style>
