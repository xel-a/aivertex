---
import { formatDate } from '../../utils/date';

interface Props {
  status: 'Planned' | 'In Progress' | 'On Hold' | 'Completed';
  version: string;
  updated: string;
}

const { status, version, updated } = Astro.props;
---

<div class="project-metadata">
  <div class="header">
    <p class="metadata-status-label">Status</p>
    <p class="metadata-version-label">Version</p>
    <p class="metadata-updated-label">Updated</p>
  </div>
  <div class="values">
    <p class="metadata-status-value">{status}</p>
    <p class="metadata-version-value">{version}</p>
    <p class="metadata-updated-value">{formatDate({ date: updated })}</p>
  </div>
</div>

<style>
  .project-metadata {
    padding: 10px 15px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font-size: var(--text-meta);
  }

  .header,
  .values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .header {
    background-color: var(--color-surface);
    border-radius: 5px;
    padding-block: 5px;
    margin-bottom: 5px;
  }

  [class^='metadata'] {
    margin: 0;
    text-align: center;
  }

  [class^='metadata-'][class$='-label'] {
    font-weight: bold;
    text-transform: uppercase;
    font-size: inherit;
  }

  [class^='metadata-'][class$='-value'] {
    font-size: inherit;
    color: var(--color-muted);
  }

  @media screen and (max-width: 768px) {
    .project-metadata {
      display: flex;
      gap: 24px;
    }

    [class^='metadata'] {
      text-align: unset;
    }

    .header,
    .values {
      grid-template-columns: 1fr;
      align-items: center;
    }

    .header {
      background-color: unset;
      padding-block: unset;
      margin-bottom: unset;
    }
  }
</style>
