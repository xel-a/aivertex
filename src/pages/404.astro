---
import Layout from '../layouts/Layout.astro';
---

<Layout pageTitle='Vertex not found'>
	<div class='not-found'>
		<div class='content'>
			<p class='eyebrow'>404</p>
			<h1 class='heading'>This point exists only in theory</h1>
			<p class='body-text'>No incoming edges. No outgoing edges. Just... here.</p>
			<a class='return-link' href='/'>&larr; Back to known coordinates</a>
		</div>

		<div class='broken-mark' aria-hidden='true'>
			<svg viewBox='0 0 360 300' xmlns='http://www.w3.org/2000/svg'>
				<line class='frag frag-a' x1='30' y1='30' x2='150' y2='128'></line>
				<line class='frag frag-b' x1='330' y1='30' x2='214' y2='126'></line>
				<line class='frag frag-c' x1='30' y1='270' x2='150' y2='176'></line>
				<line class='frag frag-d' x1='330' y1='270' x2='214' y2='178'></line>
				<line class='frag frag-axis' x1='30' y1='150' x2='150' y2='150'></line>
				<line class='frag frag-axis' x1='220' y1='150' x2='330' y2='150'></line>
				<circle class='lost-dot-core' cx='188' cy='158' r='3'></circle>
				<circle class='lost-dot-glow' cx='188' cy='158' r='4'></circle>
			</svg>
		</div>
	</div>
</Layout>

<style>
	.not-found {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		width: 100%;
		margin: 0 auto;
		padding-bottom: 40px;
	}

	.eyebrow {
		color: var(--color-link);
		letter-spacing: 4px;
	}

	.heading {
		font-size: clamp(2rem, 4vw, 4rem);
	}
	

	.body-text {
		color: var(--color-muted);
	}

	.return-link {
		display: inline-block;
		margin-top: 28px;
		color: var(--color-link);
		font-size: 14px;
		font-weight: bold;
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s ease;
	}

	.return-link:hover {
		border-color: var(--color-link);
	}

	.broken-mark {
		width: 480px;
		aspect-ratio: 480 / 400;
		height: auto
		flex-shrink: 0;
	}

	.broken-mark svg {
		width: 100%;
		height: 100%;
	}

	.frag {
		stroke: var(--color-shadow);
		stroke-width: 1;
		stroke-linecap: round;
	}

	.frag-axis {
		stroke: var(--color-link);
		opacity: 0.6;
	}

	.lost-dot-core {
		fill: var(--color-link);
	}

	.lost-dot-glow {
		fill: var(--color-link);
		fill-opacity: 0.6;
		transform-origin: 188px 158px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.frag {
			animation: drift 4.5s ease-in-out infinite;
		}
		.frag-b,
		.frag-d {
			animation-delay: -1.1s;
		}
		.frag-axis {
			animation-delay: -2.3s;
		}
		.lost-dot-core {
			animation: drift 4.5s ease-in-out infinite;
		}
		.lost-dot-glow {
			animation:
				pulse-glow 2.6s ease-out infinite 1.5s,
				drift 4.5s ease-in-out infinite;
		}
	}

	@keyframes pulse-glow {
		0% {
			r: 4;
			opacity: 0.7;
		}
		100% {
			r: 18;
			opacity: 0;
		}
	}

	@keyframes drift {
		0%,
		100% {
			transform: translate(0, 0);
		}
		50% {
			transform: translate(2.5px, -2.5px);
		}
	}

	@media screen and (max-width: 768px) {
		.not-found {
			flex-direction: column;
			justify-content: center;
			text-align: left;
		}

		.broken-mark {
			width: min(480px, 100%);
			margin-inline: auto;
		}
	}
</style>
