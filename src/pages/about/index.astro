---
import Layout from '../../layouts/Layout.astro';
import CollapseIcon from '../../components/common/CollapseIcon.astro';
import Introduction from '../../components/about/Introduction.astro';
import Vertices from '../../components/about/Vertices.astro';
import Edges from '../../components/about/Edges.astro';
import Artifacts from '../../components/about/Artifacts.astro';
import CurrentTraversal from '../../components/about/CurrentTraversal.astro';
import Milestones from '../../components/about/Milestones.astro';
import Network from '../../components/about/Network.astro';
---

<Layout pageId="about">
  <main>
    <!-- Introduction -->
    <section class="section intro">
      <Introduction />
    </section>

    <!-- Experience -->
    <section class="section" id="vertices">
      <div class="section-header">
        <h2 class="section-title">VERTICES</h2>
        <CollapseIcon />
      </div>
      <Vertices />
    </section>

    <!-- Skills -->
    <section class="section" id="edges">
      <div class="section-header">
        <h2 class="section-title">EDGES</h2>
        <CollapseIcon />
      </div>
      <Edges />
    </section>

    <!-- Projects -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">ARTIFACTS</h2>
      </div>
      <Artifacts />
    </section>

    <!-- Currently learning -->
    <section class="section" id="current-traversal">
      <div class="section-header">
        <h2 class="section-title">CURRENT TRAVERSAL</h2>
      </div>
      <CurrentTraversal variant="full" />
    </section>

    <!-- Certificates -->
    <section class="section milestones">
      <div class="section-header">
        <h2 class="section-title">MILESTONES</h2>
      </div>
      <Milestones />
    </section>

    <!-- Contact -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">NETWORK</h2>
      </div>
      <h3>Want to connect?</h3>
      <Network />
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 768px;
    margin: 0 auto;
  }

  .section.intro {
    border-top: none;
    padding-top: 0;
    padding-bottom: 68px;
    margin: 0;
  }

  .section {
    padding: 56px 0;
    border-top: 1px solid var(--color-shadow);
  }

  .section-header {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
    height: 48px;
  }

  .section-title {
    font-size: var(--text-title);
  }
</style>
