---
import Layout from '../../layouts/Layout.astro';
import Intro from '../../components/common/Intro.astro';
import Content from '../../components/common/Content.astro';
import { getBlogPosts } from '../../lib/content';

const blogPosts = await getBlogPosts();
---

<Layout pageId="blogs">
  <main>
    <section class="intro">
      <Intro
        eyebrow="Things I'm thinking about."
        hero="BLOGS"
        lead="A place to think out loud."
        body="Notes, observations, and ideas from whatever I'm currently trying to understand."
      />
    </section>

    <Content posts={blogPosts} showContentType={false} />
  </main>
</Layout>

<style>
  main {
    width: min(768px, 100%);
    margin: 0 auto;
  }
</style>
