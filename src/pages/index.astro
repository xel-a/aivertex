---
import Layout from '../layouts/Layout.astro';
import GraphView from '../components/home/GraphView.astro';
import HomepageHero from '../components/home/HomepageHero.astro';
import { getAllPosts } from '../lib/content';
import ContentItem from '../components/common/ContentItem.astro';
import { formatDate } from '../utils/date';
import { currentlyDoing } from '../data/currently-doing';

const posts = (await getAllPosts()).slice(0, 3);
---

<Layout pageId="home">
  <main>
    <div class="main-content">
      <HomepageHero />
      <section class="section">
        <h2 class="section-title">A brief history of <a href="/about">me</a></h2>
        <ul class="brief">
          <li class="brief-content">
            <p class="date">2014 - 2020</p>
            <p class="description">
              A consistent honor student with plenty of hobbies: badminton, chess, guitar, video
              games, and art. Life felt simple back then, before college.
            </p>
          </li>
          <li class="brief-content">
            <p class="date">2020 - 2024</p>
            <p class="description">
              Earned a degree in Computer Science, participated in several hackathons, and also in a <a
                href="/blogs/looking-back-at-hack4gov-2023-my-first-ctf-experience"
                >Capture the Flag (CTF)</a
              > event that sparked my interest in cybersecurity. Completed two internships—first as a
              developer, then in InfraSecOps—and later earned <a
                href="https://www.credly.com/badges/53ea3445-c8c1-4cd2-b288-cfe235bf4e7e/linked_in_profile"
                target="_blank">Google's Cybersecurity Professional Certificate</a
              >. Worked hard to graduate with Latin honors.
            </p>
          </li>
          <li class="brief-content">
            <p class="date">2025</p>
            <p class="description">
              I moved from the Philippines to Canada with my father's support. With no connections
              and little idea of what to do next, I struggled to find my footing. Somewhere along
              the way, I got burned out.
            </p>
          </li>

          <li class="brief-content">
            <p class="date">2026 - present</p>
            <p class="description">
              Currently working as a cook at a local KFC and at the same time building <a href="/"
                >aivertex</a
              >, my portfolio website. Surprisingly, this became the push I needed to rediscover my
              curiosity and start learning again. Now, I'm studying and working toward a career in
              cybersecurity.
            </p>
          </li>
        </ul>
      </section>
      <section class="section">
        <h2 class="section-title">What I'm currently doing</h2>
        <p class="currently-doing-updated-at">
          Updated {formatDate({ date: currentlyDoing.updatedAt })}
        </p>
        <ul class="section-content">
          {
            currentlyDoing.activities.map((activity) => (
              <li>
                {activity.map((part) => {
                  if (typeof part === 'string') return part;
                  else {
                    switch (part.type) {
                      case 'link':
                        return <a href={part.href}>{part.text}</a>;
                    }
                  }
                })}
              </li>
            ))
          }
        </ul>
      </section>
      <section class="section">
        <h2 class="section-title with-button">
          What's new <a href="/tags" class="section-view-more">View all topics</a>
        </h2>
        {posts.map((post) => <ContentItem post={post} showContentType={true} />)}
      </section>
    </div>
    <aside class="graph">
      <GraphView variant="compact" />
    </aside>
  </main>
</Layout>

<style>
  main {
    display: grid;
    grid-template-columns: 1fr 480px;
    margin-bottom: 40px;
    gap: 20px;
    align-items: start;
  }

  ul {
    margin: 0;
  }

  .section {
    padding-block: 56px;
  }

  .section-title {
    margin-top: 0;
  }

  .section-title.with-button {
    display: flex;
    gap: 24px;
  }

  .section-view-more {
    font-size: var(--text-action);
    padding: 5px 10px;
    color: var(--color-text);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 5px;
    cursor: pointer;
    transition:
      border 250ms ease,
      color 250ms ease;
    line-height: 1.75;
  }

  .section-view-more:hover {
    color: var(--color-link);
  }

  .brief {
    padding: 0;
    list-style: none;
  }

  .brief-content {
    display: flex;
    align-items: start;
    gap: 20px;
  }

  .brief-content .date {
    color: var(--color-muted);
    font-size: var(--text-meta);
    min-width: 90px;
    margin-top: 16px;
  }

  .brief-content .description:last-of-type {
    margin-bottom: 0;
  }

  .currently-doing-updated-at {
    color: var(--color-muted);
    font-style: italic;
  }

  .graph {
    position: sticky;
    top: 100px;
  }

  .section:not(:last-of-type) {
    border-bottom: 1px solid var(--color-border);
  }

  .section-content > * {
    line-height: 1.75;
  }

  a {
    color: var(--color-link);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border 250ms ease;
    font-weight: bold;
  }

  a:hover {
    border-color: var(--color-link);
  }

  @media screen and (max-width: 768px) {
    main {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .section:first-of-type {
      margin-top: 60px;
    }

    .brief-content {
      flex-direction: column;
    }

    .brief-content:not(:last-of-type) {
      padding-bottom: 16px;
      border-bottom: 1px solid var(--color-border);
    }

    .brief-content .date {
      margin-bottom: 0;
    }

    .brief-content .description {
      margin-top: 0;
    }
  }
</style>
