---
import Breadcrumb from '../../../components/common/Breadcrumb.astro';
import Content from '../../../components/common/Content.astro';
import Intro from '../../../components/common/Intro.astro';
import Layout from '../../../layouts/Layout.astro';
import { getPostsByType } from '../../../lib/content';

const posts = await getPostsByType('lab').then((posts) =>
  posts.filter((post) => post.data.type === 'experiment')
);
---

<Layout pageId="lab">
  <main>
    <Breadcrumb path="lab/experiments" current="Experiments" />
    <Intro
      eyebrow="Ideas, explored."
      hero="EXPERIMENTS"
      lead="A place to follow the rabbit hole."
      body="Theories, observations, and questions worth investigating."
    />
    <Content posts={posts} showContentType={false} />
  </main>
</Layout>

<style>
  main {
    width: min(768px, 100%);
    margin: 0 auto;
  }
</style>
