---
import Layout from '../../layouts/Layout.astro';
import Intro from '../../components/common/Intro.astro';
import { getPostsByType } from '../../lib/content';
import Content from '../../components/common/Content.astro';

const labs = await getPostsByType('lab');
---

<Layout pageId="lab">
  <main>
    <section class="section intro">
      <Intro
        eyebrow="Things I'm exploring, making, and documenting."
        hero="LAB"
        lead="A place to figure things out."
        body="Experiments, prototypes, notes, and things I'm curious enough to investigate."
      />
    </section>

    <Content posts={labs} showContentType={true} />
  </main>
</Layout>

<style>
  main {
    width: min(768px, 100%);
    margin: 0 auto;
  }
</style>
