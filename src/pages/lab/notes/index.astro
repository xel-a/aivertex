---
import Breadcrumb from '../../../components/common/Breadcrumb.astro';
import Content from '../../../components/common/Content.astro';
import Intro from '../../../components/common/Intro.astro';
import Layout from '../../../layouts/Layout.astro';
import { getPostsByType } from '../../../lib/content';

const posts = await getPostsByType('lab').then((posts) =>
  posts.filter((post) => post.data.type === 'note')
);
---

<Layout pageId="lab">
  <main>
    <Breadcrumb path="lab/notes" current="Notes" />
    <Intro
      eyebrow="Thoughts, considered."
      hero="NOTES"
      lead="A place where ideas are expressed."
      body="Thoughts, opinions, and observations worth putting into words."
    />
    <Content posts={posts} showContentType={false} />
  </main>
</Layout>

<style>
  main {
    width: min(768px, 100%);
    margin: 0 auto;
  }
</style>
