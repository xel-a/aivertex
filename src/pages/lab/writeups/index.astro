---
import Breadcrumb from '../../../components/common/Breadcrumb.astro';
import Content from '../../../components/common/Content.astro';
import Intro from '../../../components/common/Intro.astro';
import Layout from '../../../layouts/Layout.astro';
import { getPostsByType } from '../../../lib/content';

const posts = await getPostsByType('lab').then((posts) =>
  posts.filter((post) => post.data.type === 'writeup')
);
---

<Layout pageId="lab">
  <main>
    <Breadcrumb path="lab/writeups" current="Writeups" />
    <Intro
      eyebrow="Solutions, explained."
      hero="WRITEUPS"
      lead="A place where findings take shape."
      body="Solutions, discoveries, and findings worth sharing."
    />
    <Content posts={posts} showContentType={false} />
  </main>
</Layout>

<style>
  main {
    width: min(768px, 100%);
    margin: 0 auto;
  }
</style>
