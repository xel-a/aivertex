---
import Layout from '../../layouts/Layout.astro';
import Intro from '../../components/common/Intro.astro';
import { getPostsByType } from '../../lib/content';
import ProjectItem from '../../components/projects/ProjectItem.astro';

const projects = await getPostsByType('project');
const projectYears = [...new Set(projects.map((project) => project.data.pubDate.getFullYear()))];
---

<Layout pageId="projects">
  <main>
    <section class="intro">
      <Intro
        eyebrow="Things I've built."
        hero="PROJECTS"
        lead="A place where ideas take shape."
        body="Projects, tools, and systems I've built while solving problems and exploring new ideas."
      />
    </section>
    <section class="projects-content">
      {projectYears.map((year) => <ProjectItem year={year} posts={projects} />)}
    </section>
  </main>
</Layout>

<style>
  main {
    width: min(768px, 100%);
    margin: 0 auto;
  }

  .projects-content {
    padding-block: 56px;
  }
</style>
